{
  "expo": {
    "name": "Maab",
    "slug": "maab",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "maab",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ar": "./assets/locales/ar.json",
      "en": "./assets/locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmeddoban.maab",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "ar",
          "en"
        ]
      },
      "buildNumber": "7"
    },
    "android": {
      "package": "com.ahmeddoban.maab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-foreground.png",
        "monochromeImage": "./assets/images/android-monochrome.png",
        "backgroundColor": "#FBFAF4"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 7
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f6f0",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "ar",
            "en"
          ]
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The app uses your location to find the qibla direction and prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#18766f",
          "sounds": [
            "./assets/audio/adhan_other.mp3",
            "./assets/audio/adhan_qassas.mp3",
            "./assets/audio/adhan_qatami.mp3",
            "./assets/audio/adhan_sobhi.mp3",
            "./assets/audio/ios/adhan_other_ios.caf",
            "./assets/audio/ios/adhan_qassas_ios.caf",
            "./assets/audio/ios/adhan_qatami_ios.caf",
            "./assets/audio/ios/adhan_sobhi_ios.caf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withNoForceDark",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Teal",
            "ios": "./assets/images/app-icons/teal.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/teal-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Ocean",
            "ios": "./assets/images/app-icons/ocean.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/ocean-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Indigo",
            "ios": "./assets/images/app-icons/indigo.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/indigo-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Violet",
            "ios": "./assets/images/app-icons/violet.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/violet-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Rose",
            "ios": "./assets/images/app-icons/rose.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/rose-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Ruby",
            "ios": "./assets/images/app-icons/ruby.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/ruby-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Amber",
            "ios": "./assets/images/app-icons/amber.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/amber-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Olive",
            "ios": "./assets/images/app-icons/olive.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/olive-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          },
          {
            "name": "Slate",
            "ios": "./assets/images/app-icons/slate.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/slate-foreground.png",
              "backgroundColor": "#FBFAF4"
            }
          }
        ]
      ],
      [
        "./plugins/withDefaultIconAlias",
        {
          "name": "Emerald"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe442109-f452-4c48-b7b4-6684c03c9f30"
      }
    }
  }
}
