<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_card"
  android:clipToOutline="true"
  android:layoutDirection="rtl">

  <LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
          android:id="@+id/circle"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:src="@drawable/widget_circle" />

        <ImageView
          android:id="@+id/icon"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
          android:id="@+id/name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="—"
          android:textColor="@color/widget_card_ink"
          android:textSize="13sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="24sp"
          android:textStyle="bold" />
      </LinearLayout>

      <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/widget_card_line" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
          android:id="@+id/leftTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textColor="@color/widget_card_gray"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/left"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textColor="@color/widget_card_ink"
          android:textSize="17sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textColor="@color/widget_card_gray"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="end"
          android:maxLines="2"
          android:textColor="@color/widget_card_gray"
          android:textSize="11sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/row"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="10dp"
      android:layout_weight="1"
      android:orientation="horizontal" />
  </LinearLayout>

  <TextView
    android:id="@+id/empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="14dp"
    android:text="@string/widget_open_app"
    android:textColor="@color/widget_card_ink"
    android:textSize="13sp"
    android:visibility="gone" />
</FrameLayout>
